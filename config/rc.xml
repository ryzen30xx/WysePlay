<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <screen_strength>20</screen_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <focusDelay>200</focusDelay>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>
  <theme>
    <name>Clearlooks</name>
    <titleLayout></titleLayout>
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify>
  </theme>
  <desktops>
    <number>1</number>
    <firstdesktop>1</firstdesktop>
    <names>
      <name>AirPlay</name>
    </names>
    <popupTime>0</popupTime>
  </desktops>
  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Never</popupShow>
    <animate>no</animate>
  </resize>
  <margins>
    <top>0</top>
    <bottom>0</bottom>
    <left>0</left>
    <right>0</right>
  </margins>
  <dock>
    <position>TopLeft</position>
    <floatingX>0</floatingX>
    <floatingY>0</floatingY>
    <noStrut>no</noStrut>
    <stacking>Above</stacking>
    <direction>Vertical</direction>
    <autoHide>no</autoHide>
    <hideDelay>300</hideDelay>
    <showDelay>300</showDelay>
    <moveButton>Middle</moveButton>
  </dock>
  <keyboard>
  </keyboard>
  <mouse>
  </mouse>
  <menu>
  </menu>
  <applications>
    <application class="*">
      <decor>no</decor>
      <fullscreen>no</fullscreen>
      <focus>yes</focus>
      <layer>normal</layer>
    </application>
    <application class="uxplay">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <focus>yes</focus>
      <layer>above</layer>
    </application>
    <application class="UxPlay">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <focus>yes</focus>
      <layer>above</layer>
    </application>
    <application class="WifiKiosk">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <focus>yes</focus>
      <layer>normal</layer>
      <position force="yes">
        <x>0</x>
        <y>0</y>
      </position>
    </application>
  </applications>
</openbox_config>
