[Unit]
Description=AirPlay Kiosk Receiver (UxPlay)
After=network-online.target avahi-daemon.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=@TARGET_USER@
Group=@TARGET_USER@
PAMName=login
Environment=HOME=@TARGET_HOME@ PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
ExecStartPre=/bin/sh -c "systemctl stop getty@tty1.service || true"
ExecStart=/opt/airplay/start_kiosk.sh
Restart=always
RestartSec=3
TimeoutStopSec=5
KillMode=mixed
ExecStopPost=/bin/sh -c "pkill -9 -f 'start_kiosk|kiosk_manager|wifi_gui|uxplay' 2>/dev/null || true"

[Install]
WantedBy=multi-user.target
