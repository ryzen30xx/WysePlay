diff --git a/lib/raop_rtp_mirror.c b/lib/raop_rtp_mirror.c
index bc88472..3a35b53 100644
--- a/lib/raop_rtp_mirror.c
+++ b/lib/raop_rtp_mirror.c
@@ -287,6 +287,18 @@ raop_rtp_mirror_thread(void *arg)
                 logger_log(raop_rtp_mirror->logger, LOGGER_WARNING,
                            "raop_rtp_mirror could not set stream socket keepalive probes %d %s", sock_err, SOCKET_ERROR_STRING(sock_err));
             }
+            option = 1;
+            if (setsockopt(stream_fd, IPPROTO_TCP, TCP_NODELAY, CAST &option, sizeof(option)) < 0) {
+                int sock_err = SOCKET_GET_ERROR();
+                logger_log(raop_rtp_mirror->logger, LOGGER_WARNING,
+                           "raop_rtp_mirror could not set stream socket TCP_NODELAY %d %s", sock_err, SOCKET_ERROR_STRING(sock_err));
+            }
+            int rcvbuf_val = 65536;
+            if (setsockopt(stream_fd, SOL_SOCKET, SO_RCVBUF, CAST &rcvbuf_val, sizeof(rcvbuf_val)) < 0) {
+                int sock_err = SOCKET_GET_ERROR();
+                logger_log(raop_rtp_mirror->logger, LOGGER_WARNING,
+                           "raop_rtp_mirror could not set stream socket SO_RCVBUF %d %s", sock_err, SOCKET_ERROR_STRING(sock_err));
+            }
             readstart = 0;
         }
 
