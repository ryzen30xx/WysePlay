# ==============================================================================
# WysePlay / AirPlay Receiver Configuration
# ==============================================================================
#
# ENABLE_LOGS:
#   - false (Mặc định): KHÔNG ghi logs ra file, tự động xóa sạch log cũ trong /tmp
#                       để tiết kiệm RAM và bảo vệ hệ thống tuyệt đối.
#   - true:             Ghi toàn bộ logs của các dịch vụ (kiosk, uxplay) ra file:
#                       + /tmp/kiosk.log
#                       + /tmp/uxplay.log
#
ENABLE_LOGS=false

# DEBUG_VERBOSE:
#   - false (Mặc định): Chỉ ghi các sự kiện kết nối và trạng thái hoạt động chính.
#   - true:             Bật chế độ debug chuyên sâu của UxPlay (-FPSdata, -d) để
#                       phân tích chi tiết từng gói tin, encoder FPS và băng thông.
DEBUG_VERBOSE=false
